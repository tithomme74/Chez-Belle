---js
{ eleventyComputed: { seo: data => data.logement.seo } }
---
{% extends "base.njk" %}
{% set l = logement %}
{% block main %}
<main>
  <!-- 1. Ce que c'est, en une phrase, puis les photos -->
  <section id="logement" class="page-head" aria-labelledby="t-logement">
    <div class="wrap">
      <div class="kicker">{{ l.entete.kicker | jetons }}</div>
      <h1 id="t-logement">{{ l.entete.titre | riche | safe }}</h1>
      <p class="lead">{{ l.entete.texte | riche | safe }}</p>
      <div class="galerie g5" id="photos">
{%- for p in l.galerie %}
        {{ m.figure(p, loop.index0, not loop.first) }}
{%- endfor %}
      </div>
      <p class="plus"><button type="button" class="btn line" data-galerie-ouvrir>{{ l.bouton_photos | jetons }}</button></p>
    </div>
  </section>

  <!-- 2. Les chiffres qui comptent -->
  <section class="chiffres-sec" aria-label="En un coup d’œil">
    <div class="wrap">
      <ul class="chiffres">
{%- for c in l.chiffres %}
        <li><b>{{ c.valeur | jetons }}</b><span>{{ c.texte | riche | safe }}</span></li>
{%- endfor %}
      </ul>
    </div>
  </section>

  <!-- 3. Comment c'est organisé -->
  <section aria-labelledby="t-orga" class="orga-sec">
    <div class="wrap">
      <h2 id="t-orga">{{ l.organisation.titre | riche | safe }}</h2>
      <div class="orga">
{%- for c in l.organisation.cartes %}
        <article>
          <h3>{{ c.titre }}</h3>
          <ul class="coches">
{%- for p in c.points %}
            <li>{{ p | riche | safe }}</li>
{%- endfor %}
          </ul>
        </article>
{%- endfor %}
      </div>
{%- if l.organisation.option %}
      <p class="option-sup" style="margin-top:20px">{{ l.organisation.option | riche | safe }}</p>
{%- endif %}
    </div>
  </section>

  <!-- 4. Équipements regroupés -->
  <section aria-labelledby="t-equip" class="equip-sec">
    <div class="wrap">
      <h2 id="t-equip">{{ l.equipements.titre | riche | safe }}</h2>
      <div class="familles">
{%- for f in l.equipements.familles %}
        <div><h3>{{ f.titre }}</h3><p>{{ f.liste | join(" · ") }}</p></div>
{%- endfor %}
      </div>
    </div>
  </section>

  <!-- 5. Compris + règles, en une bande -->
  <section class="compris-sec" aria-label="Compris dans le prix et règles de la maison">
    <div class="wrap compris">
{%- for b in l.bandeau %}
      <div>
        <div class="kicker">{{ b.kicker | jetons }}</div>
        <p class="gros">{{ b.texte | riche | safe }}</p>
      </div>
{%- endfor %}
    </div>
  </section>

  <!-- 6. Un avis, puis l'action -->
  <section aria-label="Un avis et la suite" class="fin-sec">
    <div class="wrap">
{%- if l.avis_fixe.texte %}
      <figure class="avis-un">
        <blockquote>{{ l.avis_fixe.texte }}</blockquote>
        <figcaption><strong>{{ l.avis_fixe.prenom }}</strong> · {{ l.avis_fixe.date }} · Airbnb · <a href="{{ '/#avis' | lien }}">{{ l.avis_fixe.lien_autres }}</a></figcaption>
      </figure>
{%- endif %}
      <div class="plus">
        {{ m.boutons(l.boutons) }}
      </div>
    </div>
  </section>
</main>
{% endblock %}
{% block scripts %}
<script src="{{ racine }}assets/galerie.js"></script>
{% endblock %}
