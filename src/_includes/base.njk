{%- import "macros.njk" as m with context -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- if apercu %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<title>{{ seo.titre | jetons }}</title>
<meta name="description" content="{{ seo.description | jetons }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="{{ racine }}favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#F8F4EA">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.nom }}">
<meta property="og:title" content="{{ seo.og_titre | jetons }}">
<meta property="og:description" content="{{ (seo.og_description or seo.description) | jetons }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/photos/jardin.jpg">
{% block head %}{% endblock %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Jost:wght@400;500;600&family=Caveat:wght@500&display=swap">
<link rel="stylesheet" href="{{ racine }}assets/style.css">
{% block headFin %}{% endblock %}
</head>
<body>
{%- if apercu %}
<div class="bandeau-apercu" role="note">Aperçu du brouillon : ces modifications ne sont pas encore publiées. <a href="/admin/">Retour à l’admin</a></div>
{%- endif %}

<header class="top">
  <div class="wrap">
    <a class="brand" href="{{ '/' | lien }}" aria-label="{{ site.nom }}, accueil">
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="14" fill="#1E3A5C"/><path d="M5 19c3-2 5-2 7 0s5 2 7 0 5-2 7 0" stroke="#F8F4EA" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="15" cy="11" r="4" fill="#C4513A"/></svg>
      {{ site.nom }}
    </a>
    <nav class="main" aria-label="Onglets du site">
{%- for o in site.menu %}
      <a href="{{ o.lien | lien }}"{% if page.url == o.lien %} aria-current="page"{% endif %}>{{ o.label }}</a>
{%- endfor %}
    </nav>
    {{ m.lienA(site.bouton_reserver, "btn") }}
  </div>
</header>
<div class="stripes" aria-hidden="true"></div>

{% block main %}{% endblock %}

<div class="stripes" aria-hidden="true"></div>
<footer>
  <div class="wrap">
    <div class="stack" style="gap:10px">
      <a class="brand" href="{{ '/' | lien }}">{{ site.nom }}</a>
      <p>{{ site.pied.presentation }}</p>
    </div>
    <div>
      <h4>{{ site.pied.legal_titre }}</h4>
{%- for l in site.pied.legal %}
      <p>{{ l }}</p>
{%- endfor %}
    </div>
    <div>
      <h4>{{ site.pied.liens_titre }}</h4>
{%- for l in site.pied.liens %}
      <p>{{ m.lienA(l) }}</p>
{%- endfor %}
    </div>
  </div>
</footer>

<div class="barre" aria-label="Réservation rapide">
  <span class="p">{{ site.barre | riche | safe }}</span>
  {{ m.lienA(site.bouton_reserver, "btn") }}
</div>

{% block scripts %}{% endblock %}
</body>
</html>
