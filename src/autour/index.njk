---js
{ eleventyComputed: { seo: data => data.autour.seo } }
---
{% extends "base.njk" %}
{% set au = autour %}
{% set icones = {
  pied: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="13" cy="4" r="2"/><path d="M10 21l2-6 3 3v3"/><path d="M8 11l3-3 3 2 3 1"/><path d="M12 15l-1-5"/></svg>',
  velo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="5.5" cy="16.5" r="3.5"/><circle cx="18.5" cy="16.5" r="3.5"/><path d="M5.5 16.5L9 9h6l3.5 7.5"/><path d="M12 16.5L9 9"/><path d="M14 6h2.5L15 9"/></svg>',
  voiture: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 17h14v-4l-2-5H7l-2 5z"/><circle cx="8" cy="17" r="2"/><circle cx="16" cy="17" r="2"/><path d="M5 13h14"/></svg>'
} %}
{% block main %}
<main>
  <section id="autour" class="page-head" aria-labelledby="t-autour" style="padding-bottom:72px">
    <div class="wrap">
      <div class="kicker">{{ au.entete.kicker | jetons }}</div>
      <h1 id="t-autour" style="margin-top:10px">{{ au.entete.titre | riche | safe }}</h1>
      <p class="lead" style="margin-top:14px">{{ au.entete.texte | riche | safe }}</p>
      <div class="filtres" role="group" aria-label="Filtrer par envie">
        <button type="button" data-f="tout" aria-pressed="true">Tout</button>
{%- for f in au.filtres %}
        <button type="button" data-f="{{ f.cle }}" aria-pressed="false">{{ f.label }}</button>
{%- endfor %}
      </div>
      <div aria-live="polite">
{%- for f in au.filtres %}{% if f.conseil %}
        <p class="conseil{% if f.encadre %} chien{% endif %}" data-c="{{ f.cle }}" hidden>{{ f.conseil | riche | safe }}</p>
{%- endif %}{% endfor %}
      </div>
      <div class="zones">
{%- for z in au.zones %}
        <div>
          <div class="zone-head">
            {{ icones[z.cle] | safe }}
            <h3>{{ z.titre }}</h3><span>{{ z.sous_titre }}</span>
          </div>
{%- for l in au.lieux %}{% if l.zone == z.cle %}
          <div class="lieu" data-t="{{ l.filtres | join(' ') }}">
            <span class="t">{{ l.temps }}</span>
            <div><h4>{{ l.nom }}</h4><p>{{ l.texte | riche | safe }}</p>{% if l.lien and l.lien.lien %}{{ m.lienA(l.lien) }}{% endif %}</div>
          </div>
{%- endif %}{% endfor %}
          <div class="vide" hidden>{{ z.vide }}</div>
        </div>
{%- endfor %}
      </div>
{%- if au.aussi %}
      <p class="aussi">{{ au.aussi | riche | safe }}</p>
{%- endif %}
{%- if au.adresses.afficher %}
      <div class="adresses">
        <span class="signature">{{ au.adresses.titre }}</span>
        <p>{{ au.adresses.texte | riche | safe }}</p>
      </div>
{%- endif %}
    </div>
  </section>


  <section class="cta-final" aria-label="Réserver">
    <div class="wrap">
      <div class="kicker">{{ au.appel.kicker | jetons }}</div>
      <h2 style="margin-top:10px">{{ au.appel.titre | riche | safe }}</h2>
      <p class="lead">{{ au.appel.texte | riche | safe }}</p>
      <div class="hero-actions">{{ m.boutons(au.appel.boutons) }}</div>
    </div>
  </section>
</main>
{% endblock %}
{% block scripts %}
<script src="{{ racine }}assets/autour.js"></script>
{% endblock %}
