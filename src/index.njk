---js
{ eleventyComputed: { seo: data => data.accueil.seo } }
---
{% extends "base.njk" %}
{% set a = accueil %}
{% block head %}
<script type="application/ld+json">{{ a.seo.jsonld | jsonScript | safe }}</script>
<link rel="preload" as="image" href="{{ a.hero.photo.src | lien }}" imagesrcset="{{ m.srcset(a.hero.photo) }}" imagesizes="(max-width: 900px) 90vw, 480px">
{% endblock %}
{% block headFin %}
<script>
// Anciens liens (site sur une seule page) : on redirige vers le bon onglet.
(() => {
  const ANCIENS = { logement: "chez-belle/", tarifs: "tarifs-reservation/", reserver: "tarifs-reservation/#reserver", autour: "autour/", faq: "tarifs-reservation/#questions" };
  const cible = ANCIENS[location.hash.slice(1)];
  if (cible) location.replace(cible);
})();
</script>
{% endblock %}
{% block main %}
<main id="accueil">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="kicker">{{ a.hero.kicker | jetons }}</div>
        <h1 style="margin-top:14px">{{ a.hero.titre | riche | safe }}</h1>
        <p class="lead">{{ a.hero.texte | riche | safe }}</p>
        <div class="hero-actions">
          {{ m.boutons(a.hero.boutons) }}
        </div>
      </div>
      <div class="hero-photo">
        <div class="arch">
          <img src="{{ a.hero.photo.src | lien }}" srcset="{{ m.srcset(a.hero.photo) }}" sizes="(max-width: 900px) 90vw, 480px" width="{{ a.hero.photo.largeur }}" height="{{ a.hero.photo.hauteur }}" alt="{{ a.hero.photo.alt }}" fetchpriority="high">
        </div>
        <div class="badge-ticket"><b><span data-note="globale">{{ avis.notes.globale }}</span> ★</b><span data-note="badge">sur {{ avis.notes.nombre }} avis Airbnb</span></div>
      </div>
    </div>
  </section>

  <div class="stripes corail" aria-hidden="true"></div>

  <section aria-labelledby="t-essentiel">
    <div class="wrap">
      <div class="kicker">{{ a.essentiel.kicker | jetons }}</div>
      <h2 id="t-essentiel" style="margin-top:10px">{{ a.essentiel.titre | riche | safe }}</h2>
      <ul class="essentiels">
{%- for p in a.essentiel.points %}
        <li><b>{{ p.titre | jetons }}</b><span>{{ p.texte | riche | safe }}</span></li>
{%- endfor %}
      </ul>
      <div class="apercu">
        <div class="galerie">
{%- for p in a.essentiel.photos %}
          {{ m.figure(p, loop.index0) }}
{%- endfor %}
        </div>
      </div>
      <div class="plus">
        <a class="btn line" href="{{ '/chez-belle/#photos' | lien }}">{{ a.essentiel.bouton_photos | jetons }}</a>
        {{ m.lienA(a.essentiel.lien_suite) }}
      </div>
    </div>
  </section>

  <section class="tarifs" aria-labelledby="t-zoom">
    <div class="wrap">
      <div class="kicker">{{ a.zoom.kicker | jetons }}</div>
      <h2 id="t-zoom" style="margin-top:10px">{{ a.zoom.titre | riche | safe }}</h2>
      <p style="margin-top:14px">{{ a.zoom.texte | riche | safe }}</p>
      <div class="cabines zoom">
{%- for c in calc.zoom %}
        <div class="cabine{% if c.vedette %} peak{% endif %}"><div class="toit"></div><div class="in">{% if c.vedette %}<span class="peak-tag">{{ c.vedette }}</span>{% endif %}<h3>{{ c.titre }}</h3><span class="dates">{{ c.dates }}</span><span class="p num">{{ c.prix }} <small>{{ c.unite }}</small></span><span class="cond">{{ c.sejour }}</span></div></div>
{%- endfor %}
      </div>
      <div class="plus">
        {{ m.boutons(a.zoom.boutons) }}
      </div>
    </div>
  </section>

  <section id="avis" aria-labelledby="t-avis" style="background:var(--ecume)">
    <div class="wrap">
      <div class="avis-head">
        <div class="stack" style="gap:10px">
          <div class="kicker">{{ a.avis.kicker | jetons }}</div>
          <h2 id="t-avis">{{ a.avis.titre | riche | safe }}</h2>
        </div>
        <div class="notes">
          <span class="score num" data-note="globale">{{ avis.notes.globale }}</span>
          <dl class="num" id="notes-dl">
{%- for c in avis.notes.categories %}
            <dt>{{ c.nom }}</dt><dd>{{ c.note }}</dd>
{%- endfor %}
            <dt>Avis publiés</dt><dd>{{ avis.notes.nombre }}</dd>
          </dl>
          <div class="car-nav"><button type="button" id="prev" aria-label="Avis précédents">←</button><button type="button" id="next" aria-label="Avis suivants">→</button></div>
        </div>
      </div>
      <div class="car" id="car" tabindex="0" role="region" aria-label="Extraits d’avis, faire défiler"></div>
      <p class="fine">{{ a.avis.mention }} <a href="{{ site.airbnb }}" rel="noopener" target="_blank">{{ a.avis.lien_tous }}</a></p>
    </div>
  </section>

  <section class="cta-final" aria-labelledby="t-suite">
    <div class="wrap">
      <div class="kicker">{{ a.suite.kicker | jetons }}</div>
      <h2 id="t-suite" style="margin-top:10px">{{ a.suite.titre | riche | safe }}</h2>
      <p class="lead">{{ a.suite.texte | riche | safe }}</p>
      <div class="hero-actions">{{ m.boutons(a.suite.boutons) }}</div>
    </div>
  </section>
</main>
{% endblock %}
{% block scripts %}
<script>
const $ = id => document.getElementById(id);
// Avis et notes : fichier src/_data/avis.json, rempli par le flow « maj-avis-chez-belle »
// DEBUT AVIS
const AVIS = {{ avis.avis | jsonScript | safe }};
// FIN AVIS
// DEBUT NOTES
const NOTES = {{ avis.notes | jsonScript | safe }};
// FIN NOTES
document.querySelectorAll('[data-note="globale"]').forEach(e => { e.textContent = NOTES.globale; });
document.querySelectorAll('[data-note="badge"]').forEach(e => { e.textContent = `sur ${NOTES.nombre} avis Airbnb`; });
document.querySelectorAll('[data-note="resume"]').forEach(e => { e.textContent = `sur ${NOTES.nombre} avis Airbnb · ` + NOTES.categories.map(c => `${c.nom.toLowerCase()} ${c.note}`).join(" · "); });
(() => { const dl = $("notes-dl"); dl.innerHTML = ""; [...NOTES.categories, { nom: "Avis publiés", note: NOTES.nombre }].forEach(c => { const dt = document.createElement("dt"), dd = document.createElement("dd"); dt.textContent = c.nom; dd.textContent = c.note; dl.append(dt, dd); }); })();
AVIS.slice(0, 6).forEach(a => {
  const fig = document.createElement("figure");
  const q = document.createElement("blockquote"); q.textContent = (/^[a-zà-ÿ]/.test(a.extrait) ? "… " : "") + a.extrait;
  const c = document.createElement("figcaption"); const s = document.createElement("strong"); s.textContent = a.prenom;
  c.append(s, ` · ${a.date} · Airbnb`);
  fig.append(q, c); $("car").appendChild(fig);
});
const slide = d => $("car").scrollBy({ left: d * $("car").clientWidth * 0.8, behavior: "smooth" });
$("prev").addEventListener("click", () => slide(-1));
$("next").addEventListener("click", () => slide(1));
</script>
<script src="{{ racine }}assets/galerie.js"></script>
{% endblock %}
