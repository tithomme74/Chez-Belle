---js
{ eleventyComputed: { seo: data => data.reservation.seo } }
---
{% extends "base.njk" %}
{% set r = reservation %}
{% set fo = calc.formulaire %}
{% set tx = r.formulaire %}
{% block main %}
<main>
  <section class="page-head" aria-labelledby="t-page">
    <div class="wrap">
      <div class="kicker">{{ r.entete.kicker | jetons }}</div>
      <h1 id="t-page">{{ r.entete.titre | riche | safe }}</h1>
      <p class="lead">{{ r.entete.texte | riche | safe }}</p>
      <div class="hero-actions">{{ m.boutons(r.entete.boutons) }}</div>
    </div>
  </section>

  <section id="tarifs" class="grille-sec" aria-labelledby="t-tarifs">
    <div class="wrap">
      <h2 id="t-tarifs">{{ r.grille.titre | riche | safe }}</h2>
      <div class="grille-box">
        <table class="grille num">
          <thead><tr><th scope="col">Période</th><th scope="col">Prix</th><th scope="col">Séjour</th></tr></thead>
          <tbody>
{%- for g in calc.grille %}
            <tr{% if g.style %} class="{{ g.style }}"{% endif %}><th scope="row">{{ g.titre }}{% if g.etiquette %} <span class="tag">{{ g.etiquette }}</span>{% endif %}<small>{{ g.dates | riche | safe }}</small></th><td><span class="prix">{{ g.prix }}</span><small>{{ g.unite }}</small></td><td>{{ g.sejour }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
{%- if r.grille.secret %}
      <p class="secret">{{ r.grille.secret | riche | safe }}</p>
{%- endif %}
    </div>
  </section>

  <section class="inclus-sec" aria-label="Ce qui est compris dans le prix">
    <div class="wrap inclus">
      <div class="stack">
        <h2>{{ r.compris.titre | riche | safe }}</h2>
        <ul class="coches">
{%- for c in calc.compris %}
          <li>{{ c | riche | safe }}</li>
{%- endfor %}
        </ul>
      </div>
      <div class="stack">
        <h2>{{ r.en_plus.titre | riche | safe }}</h2>
        <ul class="coches plus-s">
{%- for c in calc.enPlus %}
          <li>{{ c | riche | safe }}</li>
{%- endfor %}
        </ul>
        <p class="fine">{{ r.en_plus.note | riche | safe }}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="t-etapes">
    <div class="wrap">
      <h2 id="t-etapes">{{ r.etapes.titre | riche | safe }}</h2>
      <ol class="etapes">
{%- for e in r.etapes.liste %}
        <li><div><h3>{{ e.titre }}</h3><p>{{ e.texte | riche | safe }}</p></div></li>
{%- endfor %}
      </ol>
    </div>
  </section>

  <section id="reserver" class="demande" aria-labelledby="t-reserver">
    <div class="wrap">
      <h2 id="t-reserver">{{ tx.titre }}</h2>
      <div class="req">
        <form id="f" novalidate>
          <label for="arr">{{ tx.arrivee }}<input id="arr" type="date" min="{{ fo.arrivee_min }}" max="{{ fo.arrivee_max }}"></label>
          <label for="dep">{{ tx.depart }}<input id="dep" type="date" min="{{ fo.depart_min }}" max="{{ fo.depart_max }}"></label>
          <label for="pax">{{ tx.voyageurs }}<select id="pax">{% for n in range(1, fo.voyageurs_max + 1) %}<option{% if n == fo.voyageurs_defaut %} selected{% endif %}>{{ n }}</option>{% endfor %}</select></label>
          <label for="kids">{{ tx.enfants }}<select id="kids">{% for n in range(0, fo.enfants_max + 1) %}<option{% if n == 0 %} selected{% endif %}>{{ n }}</option>{% endfor %}</select></label>
          <span class="full check"><input id="pet" type="checkbox"><label for="pet" style="display:inline;color:var(--encre)">{{ tx.chien }}</label></span>
          <label class="full" for="nom">{{ tx.nom }}<input id="nom" type="text" autocomplete="name" placeholder="{{ tx.nom_exemple }}"></label>
          <label class="full" for="contact">{{ tx.contact }}<input id="contact" type="text" autocomplete="email" placeholder="{{ tx.contact_exemple }}"></label>
          <label class="full" for="msg">{{ tx.message }}<textarea id="msg" placeholder="{{ tx.message_exemple }}"></textarea></label>
          <div class="full"><button class="btn" type="submit">{{ tx.bouton }}</button></div>
        </form>
        <div class="stack">
          <div class="estim" aria-live="polite">
            <div class="kicker" style="color:var(--marine-2)">{{ tx.estimation_titre }}</div>
            <div class="total num" id="total">—</div>
            <div id="detail" class="fine"></div>
            <ul id="lines"></ul>
            <p class="warn" id="warn" hidden></p>
            <p class="fine">{{ tx.estimation_note | riche | safe }}</p>
          </div>
          <div class="estim out" id="out" hidden>
            <div class="kicker" style="color:var(--marine-2)">{{ tx.demande_titre }}</div>
            <pre id="draft"></pre>
            <div class="row">
              <button class="btn line" type="button" id="copy">{{ tx.copier }}</button>
              <a class="btn" id="mail" href="#">{{ tx.messagerie }}</a>
            </div>
            <span id="copied" class="fine" hidden>{{ tx.copiee }}</span>
            <p class="fine">{{ tx.ecrire }} <span class="mail-belle" id="belle-mail"></span></p>
          </div>
{%- if r.mot_de_belle.texte %}
          <figure class="mot-court">
            <blockquote>{{ r.mot_de_belle.texte | riche | safe }}</blockquote>
            <figcaption class="signature">{{ r.mot_de_belle.signature }}</figcaption>
          </figure>
{%- endif %}
        </div>
      </div>
    </div>
  </section>

  <section id="questions" aria-labelledby="t-faq">
    <div class="wrap">
      <h2 id="t-faq">{{ r.faq.titre | riche | safe }}</h2>
      <div class="faq-list">
{%- for q in r.faq.questions %}
        <details><summary>{{ q.question | jetons }}</summary><p>{{ q.reponse | riche | safe }}</p></details>
{%- endfor %}
      </div>
{%- if r.faq.note %}
      <p class="fine" style="margin-top:20px">{{ r.faq.note | riche | safe }}</p>
{%- endif %}
    </div>
  </section>
</main>
{% endblock %}
{% block scripts %}
<script type="application/json" id="donnees-tarifs">{{ { types: calc.types, calendrier: calc.calendrier, chien: maison.chien, email: site.email } | jsonScript | safe }}</script>
<script src="{{ racine }}assets/reservation.js"></script>
{% endblock %}
